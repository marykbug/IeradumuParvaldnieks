<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:IeradumuParvaldnieksMAUI.ViewModels"
             x:Class="IeradumuParvaldnieksMAUI.Views.IeradumsDetalas"
             x:DataType="viewModels:IeradumsDetalasViewModel"
             Title="Ieraduma Detalas">
    <ScrollView>
        <VerticalStackLayout Padding="20"
                             Spacing="15">
            <Label Text="{Binding Ieradums.Nosaukums}"
                   FontSize="28"
                   FontAttributes="Bold" />
            <Label Text="Apraksts:"
                   FontAttributes="Bold" />
            <Label Text="{Binding Ieradums.Apraksts}" />
            <Label Text="Statuss:"
                   FontAttributes="Bold" />
            <Label Text="{Binding Ieradums.Status}" />
            <Label Text="Atkārtošanās:"
                   FontAttributes="Bold" />
            <Label Text="{Binding Ieradums.Atkartosana}" />
            <Label Text="Izveidots:"
                   FontAttributes="Bold" />
            <Label Text="{Binding Ieradums.Izveidots,
                         StringFormat='{0:dd.MM.yyyy HH:mm}'}" />
            <Label Text="Pēdējo reizi labots:"
                   FontAttributes="Bold" />
            <Label Text="{Binding Ieradums.Labots,
                         StringFormat='{0:dd.MM.yyyy HH:mm}'}" />
            <Label Text="Izpildīts šodien:"
                   FontAttributes="Bold" />
            <Label Text="{Binding IzpilditsSodien}" />
            <Button Text="Atzīmēt kā izpildītu"
                    Command="{Binding AtzimetKaIzpildituCommand}" />
            <Button Text="Arhivēt"
                    Command="{Binding ArhivetCommand}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>