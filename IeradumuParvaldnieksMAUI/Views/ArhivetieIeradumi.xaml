<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewModels="clr-namespace:IeradumuParvaldnieksMAUI.ViewModels"
    xmlns:klases="clr-namespace:IeradumuParvaldnieksKlases;assembly=IeradumuParvaldnieksKlases"
    x:Class="IeradumuParvaldnieksMAUI.Views.ArhivetieIeradumi"
    x:Name="ArhivetieIeradumiPage"
    x:DataType="viewModels:ArhivetieIeradumiViewModel"
    Title="Arhivētie ieradumi">
    <CollectionView ItemsSource="{Binding ArhivetieIeradumi}">
        <CollectionView.ItemTemplate>
            <DataTemplate x:DataType="klases:Ieradums">
                <VerticalStackLayout Padding="10">
                    <Label Text="{Binding Nosaukums}"
                           FontSize="20" />
                    <Label Text="{Binding Apraksts}" />
                    <Label Text="{Binding Atkartosana,
                                         StringFormat='Atkārtošanās: {0}'}" />
                    <Button Text="Atjaunot"
                            Command="{Binding Source={x:Reference ArhivetieIeradumiPage},
                                              Path=BindingContext.AtjaunotCommand}"
                            CommandParameter="{Binding .}" />
                </VerticalStackLayout>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>
</ContentPage>